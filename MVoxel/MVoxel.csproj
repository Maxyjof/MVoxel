<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <AssemblyName>MVoxel</AssemblyName>
        <RootNamespace>MVoxel</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="MVoxel.Tests" />
        <PackageReference Include="ImGui.NET" />
        <PackageReference Include="OpenTK" />
        <PackageReference Include="Silk.NET.Vulkan" />
        <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" />
        <PackageReference Include="Silk.NET.Shaderc" />
        <PackageReference Include="MoonSharp" />
        <PackageReference Include="Jint" />
        <Content Include="Editor\Icons\*.png" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Editor\Brand\*.png" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Editor\Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Editor\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Editor\Rendering\LICENSE.Bytesized.txt" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Plugins\**\*" CopyToOutputDirectory="PreserveNewest" />
