<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>MVoxel.App</AssemblyName>
        <RootNamespace>MVoxel.App</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="MVoxel.Tests" />
        <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
        <PackageReference Include="OpenTK" Version="4.9.4" />
        <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
        <Content Include="Editor\Icons\*.png" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Editor\Brand\*.png" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Editor\Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Editor\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Editor\Rendering\LICENSE.Bytesized.txt" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
