<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <AssemblyName>MVoxel</AssemblyName>
        <RootNamespace>MVoxel</RootNamespace>
        <ApplicationIcon>Editor\Brand\MVoxelLogo.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ImGui.NET" />
        <PackageReference Include="OpenTK" />
        <PackageReference Include="Silk.NET.Vulkan" />
        <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" />
        <PackageReference Include="Silk.NET.Shaderc" />
        <PackageReference Include="MoonSharp" />
        <PackageReference Include="Jint" />
        <Content Include="Editor\Guide\Docs\**\*.md" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Editor\Guide\Images\*.png" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Editor\Icons\*.png" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Editor\Brand\*.png" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Editor\Brand\*.ico" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Editor\Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Editor\Fonts\*.txt" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Editor\Rendering\LICENSE.Bytesized.txt" CopyToOutputDirectory="PreserveNewest" />
        <!--开源许可与第三方声明随发布物分发，勿删-->
        <Content Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\Licenses\*.txt" Link="Licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Plugins\**\*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <Target Name="BuildEditorDocking" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
        <Error Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'win-x64'" Text="定制停靠库目前仅支持 win-x64。" />
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/Native/ImGuiDocking/build.ps1&quot; -Configuration $(Configuration)" />
    </Target>
    <Target Name="CopyEditorDocking" AfterTargets="Build">
        <Copy SourceFiles="Native/ImGuiDocking/obj/$(Configuration)/cimgui.dll" DestinationFiles="$(TargetDir)cimgui.dll" />
        <Copy SourceFiles="Native/ImGuiDocking/obj/$(Configuration)/cimgui.dll" DestinationFiles="$(TargetDir)runtimes/win-x64/native/cimgui.dll" />
        <Copy SourceFiles="Native/ImGuiDocking/obj/$(Configuration)/mvoxel_video_encoder.exe" DestinationFolder="$(TargetDir)" />
    </Target>
    <Target Name="PublishEditorDocking" AfterTargets="Publish">
        <Copy SourceFiles="Native/ImGuiDocking/obj/$(Configuration)/cimgui.dll" DestinationFiles="$(PublishDir)cimgui.dll" />
        <Copy SourceFiles="Native/ImGuiDocking/obj/$(Configuration)/cimgui.dll" DestinationFiles="$(PublishDir)runtimes/win-x64/native/cimgui.dll" />
        <Copy SourceFiles="Native/ImGuiDocking/obj/$(Configuration)/mvoxel_video_encoder.exe" DestinationFolder="$(PublishDir)" />
    </Target>
</Project>
